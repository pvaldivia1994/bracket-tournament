rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /tournaments/main {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['winners', 'updatedAt'])
        && request.resource.data.winners is map
        && request.resource.data.winners.size() <= 31
        && request.resource.data.updatedAt is string;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
